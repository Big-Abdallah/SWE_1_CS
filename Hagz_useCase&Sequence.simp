<sim-project version="15.21" multi-file="no" uid="simpf68252b6defd4b349a3900e792021539" creation-date="10/19/2026 19:42:13">
  <meta>
    <name>Hagz</name>
    <authors> Abdallah Mohamed</authors>
    <description>Hagz is a web-based platform that simplifies finding, booking, and managing sports courts. It
connects Players, Court Owners, and Administrators in one organized system, following the
idea Less Searching. More Playing.
Players search and filter courts by area and price, view available time slots, and book or cancel
bookings. Court owners add courts, upload photos, set prices and availability, and accept or
reject booking requests. Administrators review and approve submitted courts and manage
users. All users can manage their own account, including updating their account and resetting
their password.</description>
  </meta>
